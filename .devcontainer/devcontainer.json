{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "mounts": [
        "source=${localEnv:GITHUB_SSH_DIR},target=/home/vscode/.ssh,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.config/gh_dist_sys_challenge,target=/home/vscode/.config/gh,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/.pi/agent,target=/home/vscode/.pi/agent,type=bind,consistency=cached"
    ],
    "remoteEnv": {
        "TZ": "Europe/Budapest",
        "GEMINI_API_KEY": "${localEnv:MY_OPENROUTER_API_KEY}",
        "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
        "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
        "OPENROUTER_API_KEY": "${localEnv:MY_OPENROUTER_API_KEY}"
    },
    "postStartCommand": "bash .devcontainer/post_start_command.sh",
    "forwardPorts": [
        8080
    ],
    "portsAttributes": {
        "8080": {
            "label": "Maelstrom",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "charliermarsh.ruff",
                "ryu1kn.partial-diff",
                "ms-python.mypy-type-checker",
                "ms-python.flake8",
                "GitHub.vscode-github-actions"
            ],
            "settings": {
                // "[python]": {
                //     "editor.defaultFormatter": "charliermarsh.ruff"
                // },
                "remote.localPortHost": "allInterfaces",
                "remote.autoForwardPorts": false,
                "mypy-type-checker.args": [
                    "--check-untyped-defs",
                    "--strict",
                    "--follow-untyped-imports"
                ],
                "mypy-type-checker.executable": "/usr/local/bin/mypy",
                "python.analysis.diagnosticSeverityOverrides": {
                    "reportUnusedImport": "warning",
                    "reportUnusedVariable": "warning"
                },
                // "editor.defaultFormatter": "charliermarsh.ruff",
                "python.analysis.typeCheckingMode": "strict"
            }
        }
    }
}