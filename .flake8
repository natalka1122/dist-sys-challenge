[flake8]
max-line-length = 100
show-source = true
; statistics = false
doctests = true
format = wemake
exclude = .git,__pycache__,.venv,tmp,notebooks/sniff.py,play*.py,notebooks/*,play/*
; E203/W503: black-compatible line-break/whitespace rules (conflict with formatter)
; WPS...: deliberately relaxed strictness — curated per-project
extend-ignore = W503,E203,H601,WPS432,WPS339,WPS111,WPS110,WPS402,WPS201,WPS203
